{
  "name": "acme-web",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint:ts": "eslint src --ext .ts",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:md": "markdownlint '**/*.md'",
    "lint:yaml": "yamllint .",
    "lint:json": "prettier --check '**/*.json'",
    "lint:spell": "cspell 'src/**'",
    "lint:licenses": "license-checker --production --onlyAllow MIT",
    "test": "vitest run"
  }
}
